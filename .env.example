# Runtime data lives outside the Git repository.
DATA_DIR=/srv/home-automation
TZ=America/Sao_Paulo

# WireGuard example settings. Keep the real topology only in the unversioned
# .env on the OCI host.
WG_SERVER_URL=auto
WG_SERVER_PORT=51820
WG_PEERS=cudy
WG_INTERNAL_SUBNET=10.99.0.0
WG_ALLOWED_IPS=10.99.0.1/32
HOME_LAN_CIDR=192.168.50.0/24

# Public HTTPS endpoint used only by Caddy/Alexa.
PUBLIC_HOSTNAME=router.example.invalid
ACME_EMAIL=admin@example.invalid

# Alexa backend -> Home Assistant.
HA_URL=http://127.0.0.1:8123
HA_TOKEN=CHANGE_ME
ALEXA_SKILL_ID=CHANGE_ME

# Optional entity overrides.
HA_ENTITY_UPTIME=sensor.cudy_uptime
HA_ENTITY_FIRMWARE=sensor.cudy_firmware
HA_ENTITY_LAN_IP=sensor.cudy_lan_ip
HA_ENTITY_CLIENTS=sensor.cudy_connected_clients
HA_ENTITY_WISP=binary_sensor.cudy_wisp
HA_ENTITY_WISP_SIGNAL=sensor.cudy_wisp_signal
HA_ENTITY_VPN=binary_sensor.cudy_vpn
HA_ENTITY_VPN_PROTOCOL=sensor.cudy_vpn_protocol
HA_ENTITY_WIFI_CHANNEL=sensor.cudy_wi_fi_channel
HA_ENTITY_GUEST_24=switch.cudy_guest_wi_fi_2_4_ghz
HA_ENTITY_GUEST_5=switch.cudy_guest_wi_fi_5_ghz
HA_ENTITY_GUEST_ALL=switch.cudy_guest_wi_fi_all
HA_ENTITY_REBOOT=button.cudy_reboot_router
HA_ENTITY_LAN_STATUS=binary_sensor.cudy_lan
HA_ENTITY_WIFI_24_STATUS=binary_sensor.cudy_wi_fi_2_4_ghz
HA_ENTITY_WIFI_5_STATUS=binary_sensor.cudy_wi_fi_5_ghz
HA_ENTITY_MESH_STATUS=binary_sensor.cudy_mesh
HA_ENTITY_DHCP_STATUS=binary_sensor.cudy_dhcp
