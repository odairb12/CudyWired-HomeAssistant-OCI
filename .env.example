# Runtime data lives outside the Git repository.
DATA_DIR=/srv/home-automation
TZ=America/Sao_Paulo

# WireGuard server settings. Use private example ranges here; keep the real
# topology only in the unversioned .env on the OCI host.
WG_SERVER_URL=auto
WG_SERVER_PORT=51820
WG_PEERS=cudy
WG_INTERNAL_SUBNET=10.99.0.0

# Split tunnel: clients only route the OCI WireGuard IP through the VPN.
WG_ALLOWED_IPS=10.99.0.1/32

# Example LAN advertised behind the Cudy for site-to-site routing.
HOME_LAN_CIDR=192.168.50.0/24
