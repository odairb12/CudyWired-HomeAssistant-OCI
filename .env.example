# Runtime data lives outside the Git repository.
DATA_DIR=/srv/home-automation
TZ=America/Sao_Paulo

# WireGuard server settings.
WG_SERVER_URL=auto
WG_SERVER_PORT=51820
WG_PEERS=cudy
WG_INTERNAL_SUBNET=10.13.13.0

# Split tunnel: clients only route the OCI WireGuard IP through the VPN.
# This avoids sending the whole home Internet connection through OCI.
WG_ALLOWED_IPS=10.13.13.1/32

# Home LAN advertised behind the Cudy for site-to-site routing.
HOME_LAN_CIDR=192.168.10.0/24
