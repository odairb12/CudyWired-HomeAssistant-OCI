# Alexa backend talks only to Home Assistant.
HA_URL=http://127.0.0.1:8123
# Dedicated Home Assistant Long-Lived Access Token.
HA_TOKEN=CHANGE_ME
# Amazon Custom Skill application ID (amzn1.ask.skill....)
ALEXA_SKILL_ID=CHANGE_ME

# Optional overrides. Defaults match the Cudy integration's stable entity names.
# Set these only if an existing Home Assistant entity registry retained older IDs.
HA_ENTITY_UPTIME=sensor.cudy_uptime
HA_ENTITY_FIRMWARE=sensor.cudy_firmware
HA_ENTITY_LAN_IP=sensor.cudy_lan_ip
HA_ENTITY_CLIENTS=sensor.cudy_connected_clients
HA_ENTITY_WISP=binary_sensor.cudy_wisp
HA_ENTITY_WISP_SIGNAL=sensor.cudy_wisp_signal
HA_ENTITY_VPN=binary_sensor.cudy_vpn
HA_ENTITY_VPN_PROTOCOL=sensor.cudy_vpn_protocol
HA_ENTITY_WIFI_CHANNEL=sensor.cudy_wifi_channel
HA_ENTITY_GUEST_24=switch.cudy_guest_wifi_2_4_ghz
HA_ENTITY_GUEST_5=switch.cudy_guest_wifi_5_ghz
HA_ENTITY_REBOOT=button.cudy_reboot_router
