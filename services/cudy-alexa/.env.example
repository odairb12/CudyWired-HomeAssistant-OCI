# Alexa backend now talks only to Home Assistant.
# Home Assistant is reachable locally because this service uses host networking.
HA_URL=http://127.0.0.1:8123
# Create a dedicated Long-Lived Access Token in Home Assistant for this service.
HA_TOKEN=CHANGE_ME
# Amazon Custom Skill application ID (amzn1.ask.skill....)
ALEXA_SKILL_ID=CHANGE_ME
